{
  "name": "qtv",
  "private": true,
  "version": "1.1.2",
  "type": "module",
  "scripts": {
    "dev": "pnpm -C web dev",
    "build": "pnpm -C web build",
    "preview": "pnpm -C web dev",
    "tauri": "tauri",
    "test": "node --experimental-strip-types --test web/tests/*.test.ts",
    "test:rust": "cargo test --manifest-path tests/rust/Cargo.toml",
    "check": "pnpm test && pnpm test:rust && pnpm typecheck",
    "typecheck": "pnpm -C web exec next typegen && pnpm -C web exec tsc --noEmit"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.1"
  },
  "packageManager": "pnpm@11.7.0",
  "license": "AGPL-3.0-only"
}
